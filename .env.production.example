# Example for staging and production. Copy to .env on the server and replace
# every "replace-me" value. Never commit the real file (.env is gitignored).
# For staging: same file, but APP_ENV=staging.

POSTGRES_USER=app
POSTGRES_PASSWORD=replace-me-with-a-long-random-password
POSTGRES_DB=app
EMBEDDING_DIM=3

# No config page here: PUT /api/config returns 404 and only the switches
# below count. Values saved from the config page in local/test are ignored.
APP_ENV=production
AUTH_ENABLED=true
USER_MANAGEMENT_ENABLED=true

# Shorter sessions than in local development.
SESSION_TTL_MINUTES=30

# Root admin, created or updated when the backend starts.
ADMIN_EMAIL=admin@your-domain.example
ADMIN_PASSWORD=replace-me-with-a-long-random-password

# Host ports. Also remove the db port mapping in docker-compose.yml so the
# database is not reachable from outside (see readme, "Produktion").
DB_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000
