# Copy to .env and adjust. docker compose reads .env automatically.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
# Length of the vector in items.embedding. Changing it on an existing
# database requires recreating the items table (or docker compose down -v).
EMBEDDING_DIM=3
# Environment: local | test | staging | production. The config page (switching
# login and user management on/off) only exists in local and test.
APP_ENV=local
# Feature switches. In local/test the config page can override them; in
# staging/production these values are the only source.
AUTH_ENABLED=false
USER_MANAGEMENT_ENABLED=false
# How long a login session (Bearer token) is valid.
SESSION_TTL_MINUTES=60
# Root admin, created or updated when the backend starts. Leave the password
# empty to skip it. Change it outside local development.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Host ports. Change them if another project already uses them.
DB_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000
